# Copy this file to .env and change values before deployment.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/private_vault

# Your initial 2 factors. They are used only to create the first account,
# then the stored values are bcrypt hashes.
INITIAL_PIN=20082011
INITIAL_PASSWORD=Bahromu

# WebAuthn / Passkey
RP_NAME=Private Vault
RP_ID=localhost
ORIGIN=http://localhost:3000

# Long random value for sessions. Generate your own in production.
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
